# Только имена переменных. Реальные значения задайте локально или в настройках хостинга.
# Legacy direct Sheets API only; neither public form uses these variables now.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# В .env.local допускается строка в двойных кавычках с литеральными \n.
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Both preorder and waitlist: Google Apps Script (server only).
GOOGLE_SCRIPT_URL=
GOOGLE_SCRIPT_SECRET=

# Supabase: server-only. Set all three to switch database and uploads together.
# Percent-encode reserved characters in the database password.
DATABASE_URL=
# Optional: Supabase root certificate PEM; literal \n supported. Verification stays enabled.
DATABASE_SSL_CA=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional admin override: set both together. Server only, password 12-256 characters.
# When absent, existing database/file credentials are used.
ADMIN_LOGIN=
ADMIN_PASSWORD=
